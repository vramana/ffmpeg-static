{
  "name": "@vramana/ffmpeg",
  "version": "0.0.0",
  "description": "Static ffmpeg and ffprobe binaries for Linux, macOS and Windows",
  "keywords": ["ffmpeg", "ffprobe", "static", "binary"],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vramana/ffmpeg-static.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ffmpeg": "bin/ffmpeg.js",
    "ffprobe": "bin/ffprobe.js"
  },
  "files": ["index.js", "index.mjs", "index.d.ts", "bin/"],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@vramana/ffmpeg-darwin-arm64": "0.0.0",
    "@vramana/ffmpeg-linux-x64": "0.0.0",
    "@vramana/ffmpeg-win32-arm64": "0.0.0",
    "@vramana/ffmpeg-win32-x64": "0.0.0"
  }
}
